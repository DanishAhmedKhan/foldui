{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "FoldUI Content Schema",
    "type": "object",
    "required": [
        "version",
        "root"
    ],
    "properties": {
        "version": {
            "type": "string"
        },
        "root": {
            "$ref": "#/definitions/node"
        }
    },
    "definitions": {
        "node": {
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "fragment",
                        "section",
                        "container",
                        "text",
                        "image",
                        "button",
                        "list",
                        "list-item",
                        "custom"
                    ]
                },
                "props": {
                    "type": "object",
                    "additionalProperties": true
                },
                "style": {
                    "type": "object",
                    "additionalProperties": true
                },
                "responsive": {
                    "type": "object",
                    "additionalProperties": true
                },
                "states": {
                    "type": "object",
                    "additionalProperties": true
                },
                "children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/node"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}